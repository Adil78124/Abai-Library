NODE_ENV=production
PORT=3001

# Required: use a unique 32+ character secret.
SESSION_SECRET=replace-with-a-random-32-plus-character-secret
SESSION_NAME=sid
SESSION_MAX_AGE=2592000000

# Use COOKIE_SAME_SITE=none only when frontend/backend are on different sites.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Comma-separated frontend origins. Do not use wildcard with credentials.
CORS_ORIGIN=https://your-frontend.example.com

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/abai_library
REDIS_URL=redis://redis:6379

DEFAULT_RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
AI_CHAT_RATE_LIMIT_PER_MINUTE=20
HEALTH_CHECK_TIMEOUT_MS=3000
BCRYPT_SALT_ROUNDS=12

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=abai-library
MINIO_PUBLIC_URL=https://your-minio-public.example.com
MINIO_REGION=us-east-1

N8N_BOOK_PROCESSING_WEBHOOK_URL=https://n8n.example.com/webhook/book-processing
N8N_CHAT_WEBHOOK_URL=https://n8n.example.com/webhook/book-chat
N8N_WEBHOOK_SECRET=replace-with-n8n-shared-secret
N8N_CALLBACK_SECRET=replace-with-n8n-callback-secret
N8N_TIMEOUT_MS=30000
