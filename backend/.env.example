# PostgreSQL (required for runtime and prisma migrate)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abai_library

# Redis session store (required)
REDIS_URL=redis://localhost:6379

# Session cookie signing (required — no default in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed origins for CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Server port
PORT=3001

# Optional
SESSION_NAME=sid
SESSION_MAX_AGE=2592000000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
DEFAULT_RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
AI_CHAT_RATE_LIMIT_PER_MINUTE=20
HEALTH_CHECK_TIMEOUT_MS=3000
BCRYPT_SALT_ROUNDS=10
NODE_ENV=development

# MinIO / S3-compatible storage (required for file uploads)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=abai-library
# Публичный URL для ссылок на файлы (если отличается от endpoint)
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1

# N8N integration (optional until workflows are configured)
N8N_BOOK_PROCESSING_WEBHOOK_URL=
N8N_CHAT_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=
N8N_TIMEOUT_MS=30000
